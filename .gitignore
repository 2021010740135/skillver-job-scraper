# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env

# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test and tool caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Project-generated local files
docs/

# Local analysis outputs (Excel / charts / Markdown reports)
data/reports/

# Skillver: commit catalog; ignore local run state / scrape / export outputs.
# Keep directory placeholders via .gitkeep.
data/skillver/seen_jobs.json
data/skillver/jobs/*
!data/skillver/jobs/.gitkeep
data/skillver/details/*
!data/skillver/details/.gitkeep
data/skillver/exports/*
!data/skillver/exports/.gitkeep
data/skillver/eval/*
!data/skillver/eval/.gitkeep
data/skillver/task_state_*.json
data/exports/

# YATN company-job scrape: commit companies.csv; ignore local outputs.
data/yatn/jobs/*
!data/yatn/jobs/.gitkeep
data/yatn/details/*
!data/yatn/details/.gitkeep
data/yatn/exports/*
!data/yatn/exports/.gitkeep

# Local skill tooling config (baoyu-image-gen etc.)
.baoyu-skills/

# Editor and OS files
.idea/
.vscode/
.DS_Store
._*
Thumbs.db

